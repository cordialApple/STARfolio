{
  "agent": {
    "metrics_collection_interval": 10
  },
  "metrics": {
    "namespace": "STARfolio/MoshiRAG",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "nvidia_gpu": {
        "measurement": [
          "memory_used",
          "memory_free",
          "memory_total",
          "utilization_gpu"
        ],
        "metrics_collection_interval": 10
      }
    }
  }
}
